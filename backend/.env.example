# Copier ce fichier en `.env` et adapter si besoin (le `.env` ne doit jamais
# être commité). Ces variables sont lues directement par src/db.ts,
# src/auth/jwt.ts et scripts/migrate.js.
#
# Le projet n'utilise pas encore de bibliothèque comme `dotenv` : soit vous en
# ajoutez une (npm install dotenv, puis `import 'dotenv/config'` en tête de
# src/index.ts), soit vous définissez ces variables manuellement dans
# Anaconda Prompt avant de lancer les commandes, ex. :
#   set PGDATABASE=ifiwera
#   set JWT_SECRET=un-secret-long-et-aleatoire
#
# Les valeurs ci-dessous correspondent au docker-compose.yml fourni à la
# racine du projet.

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=ifiwera

# Obligatoire en production (l'application refuse de démarrer sans ça si
# NODE_ENV=production) ; en développement, un secret par défaut non sécurisé
# est utilisé avec un avertissement dans les logs si cette variable est absente.
JWT_SECRET=change-moi-en-production

NODE_ENV=development
PORT=4000
